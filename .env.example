# Buat key di https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Rahasia untuk menandatangani cookie sesi. Gunakan nilai acak yang panjang di production.
AUTH_SECRET=replace_with_a_long_random_value

# Google Identity Services. Nilai default aplikasi sudah tersedia di source,
# tetapi variabel ini memudahkan penggantian client ID per environment.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=387808803237-gk557d0gedb718am1p2vdd71ejofitmd.apps.googleusercontent.com

# Analisis menggunakan beberapa model :free dengan fallback otomatis.
