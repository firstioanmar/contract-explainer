# Buat key di https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Rahasia untuk menandatangani cookie sesi. Gunakan nilai acak yang panjang di production.
AUTH_SECRET=replace_with_a_long_random_value

# Google Identity Services. Nilai default aplikasi sudah tersedia di source,
# tetapi variabel ini memudahkan penggantian client ID per environment.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=387808803237-gk557d0gedb718am1p2vdd71ejofitmd.apps.googleusercontent.com

# Analisis selalu mencoba lapis model gratis lebih dulu, bergiliran agar beban
# tersebar. Variabel ini menentukan sejauh mana lapis berbayar boleh menebus
# bagian yang gagal:
#   none  = gratis saja; dokumen bisa gagal saat lapis gratis antre atau kena limit
#   murah = gratis lalu model berbayar sangat murah (~$0,0006 per bagian dokumen)
#   andal = ditambah satu model yang lebih stabil (~$0,0016) sebagai penyelamat terakhir
# Lapis berbayar hanya tersentuh saat lapis gratis gagal, jadi biayanya
# mengikuti tingkat kegagalan, bukan jumlah analisis.
PAID_FALLBACK_TIER=murah

# Deadline internal harus lebih pendek daripada batas Vercel Fluid Compute
# (300 detik pada Hobby) agar server masih sempat mengirim respons yang jelas.
ANALYSIS_TIME_BUDGET_SECONDS=240
SHORT_ANALYSIS_TIME_BUDGET_SECONDS=90

# Batas waktu satu model untuk satu bagian dokumen. Tanpa ini, satu model gratis
# yang menggantung bisa menghabiskan seluruh anggaran waktu sendirian sehingga
# rantai cadangan tidak pernah sempat dicoba.
PER_MODEL_TIMEOUT_SECONDS=70

# Berapa model gratis yang dicoba untuk satu bagian sebelum turun ke lapis
# berbayar. Mencoba seluruhnya menghabiskan ~200 detik dari anggaran 240 detik,
# jadi dokumen dengan beberapa bagian pasti kehabisan waktu. Rotasi tetap
# membuat seluruh model gratis terpakai lintas bagian. Naikkan untuk lebih
# hemat, turunkan ke 0 untuk mengutamakan kecepatan.
MAX_FREE_ATTEMPTS_PER_CHUNK=2

# Hanya untuk npm run eval:contracts; mencegah satu model menahan seluruh evaluasi.
EVALUATION_REQUEST_TIMEOUT_SECONDS=45
